// --- Admin APIs ---
app.get('/api/admin/audit/events', async (c) => {
  const afterText = c.req.query('after_id') || '0'
  const limitText = c.req.query('limit') || '100'
  if (!/^\d+$/.test(afterText) || !/^\d+$/.test(limitText)) {
    return jsonError(c, 'Invalid audit pagination')
  }
  const afterId = Number(afterText)
  const limit = Number(limitText)
  if (!Number.isSafeInteger(afterId) || afterId < 0 || !Number.isSafeInteger(limit) || limit < 1 || limit > 500) {
    return jsonError(c, 'Invalid audit pagination')
  }
  const { results } = await c.env.DB.prepare(
    `SELECT event_id, actor_user_id, event_type, target_id, details_json, created_at
     FROM audit_outbox WHERE event_id > ? ORDER BY event_id ASC LIMIT ?`,
  )
    .bind(afterId, limit + 1)
    .all()
  const rows: any[] = results || []
  const hasMore = rows.length > limit
  const page = rows.slice(0, limit).map((row) => ({
    event_id: row.event_id,
    actor_user_id: row.actor_user_id,
    event_type: row.event_type,
    target_id: row.target_id,
    details: JSON.parse(String(row.details_json)),
    created_at: row.created_at,
  }))
  return c.json({
    events: page,
    next_after_id: page.length ? page[page.length - 1].event_id : afterId,
    has_more: hasMore,
  })
})

app.get('/api/admin/sessions', async (c) => {
  const limitText = c.req.query('limit') || '50'
  const limit = /^\d+$/.test(limitText) ? Math.min(100, Math.max(1, Number(limitText))) : 50
  const phone = (c.req.query('phone') || '').trim().slice(0, 16)
  const status = c.req.query('status') || ''
  if (status && !['active', 'expired', 'revoked'].includes(status)) {
    return jsonError(c, 'Invalid status filter')
  }
  const statusExpr = `CASE WHEN s.status = 'active' AND datetime(s.expires_at) <= datetime('now') THEN 'expired' ELSE s.status END`
  const clauses = ['(? = \'\' OR u.phone_number LIKE ?)']
  const bindings: any[] = [phone, `%${phone}%`]
  if (status) {
    clauses.push(`${statusExpr} = ?`)
    bindings.push(status)
  }
  const { results } = await c.env.DB.prepare(
    `SELECT s.id, s.user_id, u.phone_number, u.full_name, s.mac_address,
            s.duration_hours, s.expires_at, ${statusExpr} AS status, s.created_at
     FROM access_sessions s JOIN users u ON u.id = s.user_id
     WHERE ${clauses.join(' AND ')}
     ORDER BY s.created_at DESC LIMIT ?`,
  )
    .bind(...bindings, limit)
    .all()
  return c.json({ sessions: results || [] })
})

app.post('/api/admin/sessions/:id/revoke', async (c) => {
  const id = c.req.param('id')
  if (id.length > 100) return jsonError(c, 'Invalid session ID')
  const results = await c.env.DB.batch([
    c.env.DB.prepare(
      `UPDATE access_sessions SET status = 'revoked' WHERE id = ? AND status = 'active'`,
    ).bind(id),
    c.env.DB.prepare(
      `INSERT INTO audit_outbox (actor_user_id, event_type, target_id, details_json)
       SELECT NULL, 'admin.session_revoked', id, '{"actor":"admin"}'
       FROM access_sessions WHERE id = ? AND status = 'revoked' AND changes() = 1`,
    ).bind(id),
  ])
  if (results[0].meta.changes !== 1) return jsonError(c, 'Active session not found', 404)
  return c.json({ success: true, id })
})

