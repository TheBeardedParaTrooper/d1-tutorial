        let currentUser = USER;

        function esc(s) {
          return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }
        function idemKey() {
          return crypto.randomUUID ? crypto.randomUUID() : Array.from(crypto.getRandomValues(new Uint8Array(16)), b => b.toString(16).padStart(2, '0')).join('');
        }
        function showErr(msg) {
          const el = document.getElementById('err-banner');
          el.textContent = msg;
          el.classList.remove('hidden');
        }
        function clearErr() { document.getElementById('err-banner').classList.add('hidden'); }

        async function api(path, opts = {}) {
          const res = await fetch(path, { credentials: 'same-origin', ...opts });
          let body = null;
          try { body = await res.json(); } catch {}
          if (!res.ok) {
            if (res.status === 401) { window.location.href = '/account'; throw new Error('auth'); }
            throw new Error((body && body.error) || \`HTTP \${res.status}\`);
          }
          return body;
        }

        async function loadWallet() {
          try {
            const data = await api('/api/wallet/' + encodeURIComponent(currentUser.id));
            document.getElementById('balance').textContent = Number(data.wallet.balance).toLocaleString();
            document.getElementById('balance-updated').textContent = data.wallet.updated_at || '—';
          } catch (e) {
            document.getElementById('balance').textContent = '—';
            document.getElementById('balance-updated').textContent = 'unavailable';
          }
        }

        async function loadTransactions() {
          const tbody = document.getElementById('tx-body');
          try {
            const data = await api('/api/transactions/' + encodeURIComponent(currentUser.id));
            const rows = Array.isArray(data.transactions) ? data.transactions : [];
            document.getElementById('tx-count').textContent = rows.length + ' records';
            if (rows.length === 0) {
              tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-slate-500 text-sm">No transactions yet.</td></tr>';
              return;
            }
            tbody.innerHTML = rows.map(tx => {
              const amt = Number(tx.amount);
              const isCredit = String(tx.type).includes('IN') || String(tx.type).includes('DEPOSIT');
              const cls = isCredit ? 'text-emerald-400' : 'text-slate-200';
              const sign = isCredit ? '+' : '−';
              return '<tr>' +
                '<td class="py-3 pr-4 font-medium text-slate-200">' + esc(tx.type) + '</td>' +
                '<td class="py-3 pr-4 font-semibold ' + cls + '">' + sign + amt.toLocaleString() + ' TZS</td>' +
                '<td class="py-3 pr-4 text-xs font-mono text-slate-500 max-w-[16rem] truncate">' + esc(tx.reference_id || '—') + '</td>' +
                '<td class="py-3 pr-4"><span class="rounded-full border border-slate-700 px-2 py-1 text-xs text-slate-300">' + esc(tx.status) + '</span></td>' +
                '<td class="py-3 text-xs text-slate-500 whitespace-nowrap">' + esc(tx.created_at || '—') + '</td>' +
              '</tr>';
            }).join('');
          } catch (e) {
            tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-rose-400 text-sm">Failed to load transactions.</td></tr>';
          }
        }

        async function loadTiers() {
          const container = document.getElementById('tiers');
          try {
            const data = await api('/api/packages');
            const pkgs = Array.isArray(data.packages) ? data.packages : [];
            if (pkgs.length === 0) {
              container.innerHTML = '<p class="text-slate-500 text-sm col-span-full">No plans available.</p>';
              return;
            }
            container.innerHTML = pkgs.map(pkg => (
              '<button type="button" onclick="selectTier(' + esc(JSON.stringify(pkg)) + ')" ' +
              'class="text-left bg-slate-950/70 border border-slate-800 hover:border-indigo-500 rounded-2xl p-4 transition group">' +
                '<p class="font-bold text-slate-100 group-hover:text-white">' + esc(pkg.name) + '</p>' +
                '<p class="text-xs text-slate-400 mt-1">' + pkg.duration_hours + ' hours access</p>' +
                '<p class="mt-3 text-lg font-bold text-indigo-400">' + Number(pkg.price).toLocaleString() + ' <span class="text-xs text-slate-500">TZS</span></p>' +
              '</button>'
            )).join('');
          } catch (e) {
            container.innerHTML = '<p class="text-rose-400 text-sm col-span-full">Failed to load plans.</p>';
          }
        }

        function selectTier(pkg) {
          selectedTier = pkg;
          document.getElementById('selected-tier-name').textContent = pkg.name;
          document.getElementById('selected-tier-price').textContent = Number(pkg.price).toLocaleString();
          document.getElementById('buy-form').classList.remove('hidden');
          document.getElementById('buy-error').classList.add('hidden');
          document.getElementById('inp-mac').focus();
        }

        async function buySession() {
          if (!selectedTier) return;
          const mac = document.getElementById('inp-mac').value.trim();
          const errEl = document.getElementById('buy-error');
          const btn = document.getElementById('btn-buy');
          errEl.classList.add('hidden');

          if (!/^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$/.test(mac)) {
            errEl.textContent = 'Enter a valid MAC address (e.g. AA:BB:CC:DD:EE:FF).';
            errEl.classList.remove('hidden');
            return;
          }

          btn.disabled = true;
          btn.textContent = 'Processing…';

          try {
            const res = await fetch('/api/session/buy', {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/json',
                'Idempotency-Key': idemKey()
              },
              body: JSON.stringify({ package_id: selectedTier.id, mac_address: mac })
            });
            const body = await res.json();
            if (!res.ok) {
              if (res.status === 401) { window.location.href = '/account'; return; }
              throw new Error(body.error || ('HTTP ' + res.status));
            }

            // Show success
            btn.textContent = '✓ Success!';
            btn.classList.remove('bg-indigo-600', 'hover:bg-indigo-500');
            btn.classList.add('bg-emerald-600');
            setTimeout(() => {
              btn.disabled = false;
              btn.textContent = 'Confirm purchase';
              btn.classList.remove('bg-emerald-600');
              btn.classList.add('bg-indigo-600', 'hover:bg-indigo-500');
              document.getElementById('buy-form').classList.add('hidden');
              document.getElementById('inp-mac').value = '';
              selectedTier = null;
              refreshAll();
              alert('Internet access granted for ' + mac + ' until ' + new Date(body.session.expires_at).toLocaleString() + '.');
            }, 900);
          } catch (e) {
            errEl.textContent = e.message;
            errEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Confirm purchase';
          }
        }

        async function refreshAll() {
          clearErr();
          await Promise.all([loadWallet(), loadTransactions(), loadTiers()]);
        }

        async function doLogout() {
          try {
            await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' });
          } catch {}
          window.location.href = '/account';
        }

        (async function boot() {
          document.getElementById('user-name').textContent = currentUser.full_name || '—';
          document.getElementById('user-phone').textContent = currentUser.phone_number || '—';
          document.getElementById('user-id').textContent = currentUser.id || '—';
          document.getElementById('loading').classList.add('hidden');
          document.getElementById('dashboard').classList.remove('hidden');
          await refreshAll();
        })();
      </script>
    </body>
    </html>
  `)
})

