{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "d1-tutorial",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "flat-coin-isp-db",
			"database_id": "4432cead-ccc2-4bd8-b753-bd5e790be3ac"
		},
		{
			"binding": "flatcoin_isp",
			"database_name": "flatcoin-isp",
			"database_id": "552f8718-382e-4a40-b535-1a3dcf49dd83",
			"remote": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/"
		]
	},
	"vars": {
		"PORTAL_ORIGIN": "https://d1-tutorial.itsfranktenor.workers.dev"
	}
}